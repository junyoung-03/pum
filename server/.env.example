# 이 파일을 복사해서 .env 파일을 만들고 본인 MySQL 정보로 바꿔 주세요.
#   (Windows) copy .env.example .env
# .env는 .gitignore에 들어 있어서 GitHub에 올라가지 않습니다.

PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=본인_MySQL_비밀번호
DB_NAME=scentique
DB_NAME_TEST=scentique_test

JWT_SECRET=아무_긴_문자열로_바꾸세요
JWT_EXPIRES_IN=2h
